# Rename this file to .env and fill in your own values
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/thrifto
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# Used once by "npm run seed" to create the first admin account
ADMIN_NAME=Thrifto Admin
ADMIN_EMAIL=admin@thrifto.com
ADMIN_PASSWORD=ChangeMe123!
